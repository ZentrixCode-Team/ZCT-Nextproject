{
  "kind": "collectionType",
  "collectionName": "ticket_replies",
  "info": {
    "singularName": "ticket-reply",
    "pluralName": "ticket-replies",
    "displayName": "ticket-reply"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "message": {
      "type": "string",
      "required": true
    },
    "isFromSupport": {
      "type": "boolean",
      "default": false
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "ticket": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::ticket.ticket",
      "inversedBy": "ticket_replies"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "ticket_replies"
    }
  }
}
